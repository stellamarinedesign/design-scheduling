rules_version = '2';

// Firestore security rules for Design Scheduling. The canonical copy: deploy
// from this folder with `firebase deploy --only firestore:rules`. No
// addresses live here: who is what is the settings/access document, which
// these rules read. Modelled on the production board's rules.
//
// THE MODEL. An account counts only if a master listed it. Every read needs a
// LISTED account, so a Firebase user nobody listed reads nothing - which is
// what makes it safe for the app to create users. The rules are the
// enforcement; hiding controls in the UI is tidiness.
//
//   lead         everything
//   designer     reads all tasks (paths and blocked-by chips need them);
//                creates their own; edits what they created or are assigned,
//                and the steps and sections inside those at any depth the
//                walk below reaches; never marks anything done (only a lead
//                does, by any route: decided 2026-11-04), never sends back,
//                never sets checkedBy/checkedAt, never reassigns (assignee
//                and createdBy are the lead's to change); may take their own
//                submission back
//   manager      (Phase 2) reads only jobs shared with managers; posts
//                `request` updates on them
//   contributor  (Phase 2) the Log only: no tasks at all
//
// Phase 2 brings the team. Every refusal above wants proving with a test
// account before the team relies on it (PLAN, "Verification: Rules").

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // The one document that says who is what. Read once per request by the
    // rules (a get() costs one read, cached within the request). Missing, it
    // fails closed: nobody is anything.
    function accessExists() { return exists(/databases/$(database)/documents/settings/access); }
    function access() { return get(/databases/$(database)/documents/settings/access).data; }
    function email() { return request.auth.token.email.lower(); }
    function onList(name) { return accessExists() && email() in access().get(name, []); }

    function lead()        { return signedIn() && onList('leads'); }
    function designer()    { return signedIn() && onList('designers'); }
    function manager()     { return signedIn() && onList('managers'); }
    function contributor() { return signedIn() && onList('contributors'); }
    function listed()      { return lead() || designer() || manager() || contributor(); }

    // MASTERS are not a role: a master is whatever role they are, and the only
    // one who may change the lists. With no masters list, or an empty one, the
    // first lead listed is the master - so the document can be claimed and
    // then handed on from inside the app.
    function masters() {
      let m = access().get('masters', []);
      return m.size() > 0 ? m : [access().get('leads', [''])[0]];
    }
    function master() { return signedIn() && accessExists() && email() in masters(); }

    // ---- settings ----------------------------------------------------------
    // The first-run claim: when the document does not exist yet, whoever is
    // setting up creates it - and must list themselves as a lead in it, so a
    // claim cannot hand the app to somebody else.
    match /settings/access {
      // Readable before it exists too, so the app can tell a new project
      // (offer the claim) from an account nobody listed (show nothing).
      allow read: if listed() || (signedIn() && !accessExists());
      allow create: if signedIn() && !accessExists() && email() in request.resource.data.get('leads', []);
      allow update, delete: if master();
    }

    // ---- people: display names --------------------------------------------
    // Your own name, or (the lead, a master) anyone's. Just a name.
    match /people/{who} {
      allow read: if listed();
      allow write: if signedIn() && (who == email() || lead() || master())
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
    }

    // ---- the tree: groups, products, tasks and steps -----------------------
    match /tasks/{id} {
      function data() { return request.resource.data; }
      function was() { return resource.data; }
      function kindIs(k) { return data().kind == k; }
      function isMine(d) { return d.get('createdBy', '') == email() || d.get('assignee', '') == email(); }
      // Groups and steps inside a job belong to whoever owns their parent: one
      // getAfter() on it. AFTER, because a new job and its template steps are
      // written in one batch, and plain exists()/get() cannot see a parent
      // created in the same batch. Steps and groups carry createdBy, so a
      // sub-step under a step the designer made passes too. (A sub-step under
      // a step someone else made is a level further; Phase 2 hardening
      // decides whether designers get that far.)
      //
      // DEEPER (Phase 2): a step the lead's template made has the lead as its
      // createdBy, so a designer ticking a SUB-step of it in their own job
      // was refused. When the parent is not theirs, the walk goes on up
      // through steps and sections to the task they sit in, at most four
      // levels (rules cannot loop; templates nest two deep). Repeated gets of
      // one document within a request are counted once.
      function nodeAfter(id) { return getAfter(/databases/$(database)/documents/tasks/$(id)).data; }
      function taskMine(n) { return n.kind == 'task' && isMine(n); }
      function inJob(n) { return n.kind in ['step', 'group'] && n.get('parentId', null) != null; }
      function walk4(id) { return taskMine(nodeAfter(id)); }
      function walk3(id) { let n = nodeAfter(id); return taskMine(n) || (inJob(n) && walk4(n.parentId)); }
      function walk2(id) { let n = nodeAfter(id); return taskMine(n) || (inJob(n) && walk3(n.parentId)); }
      function walkUp(id) { let n = nodeAfter(id); return inJob(n) && walk2(n.parentId); }
      function ownsParentOf(d) {
        return d.get('parentId', null) != null
          && existsAfter(/databases/$(database)/documents/tasks/$(d.parentId))
          && (isMine(nodeAfter(d.parentId)) || walkUp(d.parentId));
      }
      // Sharing with managers is the lead's decision alone.
      function sharingKeys() { return ['shared', 'sharedEffective', 'shareLevel']; }
      function noSharingOnCreate() { return !data().keys().hasAny(sharingKeys()); }
      function noSharingChange() { return !data().diff(was()).affectedKeys().hasAny(sharingKeys()); }
      // Only a lead marks anything done. A non-lead write may never produce
      // 'done': not on create, and not as a change on update (a task that is
      // already done may still have its other fields edited by its owner).
      function noDoneOnCreate() { return data().get('status', 'todo') != 'done'; }
      function noNewDone() { return was().get('status', '') == 'done' || data().get('status', '') != 'done'; }
      // Who has a task, and who made it, are the lead's to change: a designer
      // cannot hand their work on, or claim someone else's.
      function noOwnerChange() { return !data().diff(was()).affectedKeys().hasAny(['assignee', 'createdBy']); }
      // Only a lead approves (check -> done) or sends back (check -> fix).
      function noReview() {
        return !(was().get('status', '') == 'check' && data().get('status', '') in ['done', 'fix'])
          && !data().diff(was()).affectedKeys().hasAny(['checkedBy', 'checkedAt']);
      }

      allow read: if lead() || designer()
        || (manager() && resource.data.get('sharedEffective', false) == true);

      allow create: if lead() || (designer() && data().get('checkedBy', null) == null && noSharingOnCreate() && noDoneOnCreate() && (
           (kindIs('task') && data().createdBy == email())
        || ((kindIs('step') || kindIs('group')) && ownsParentOf(data()))));

      // A group or step must belong to the designer's work both where it was
      // and where it goes: checking only the old parent let a section be
      // moved to the top or into a lead's category, or a step into someone
      // else's job.
      allow update: if lead() || (designer() && noReview() && noNewDone() && noSharingChange() && data().kind == was().kind && (
           (was().kind == 'task' && isMine(was()) && noOwnerChange())
        || (was().kind in ['step', 'group'] && ownsParentOf(was()) && ownsParentOf(data()))));

      allow delete: if lead();

      // The timeline. Anyone who can read the task posts as themselves; the
      // author may correct their own text and nothing else. Only a lead
      // deletes, and only to take a deleted task's timeline with it.
      match /updates/{uid} {
        function task() { return get(/databases/$(database)/documents/tasks/$(id)).data; }
        allow read: if lead() || designer()
          || (manager() && task().get('sharedEffective', false) == true);
        // Approve and send-back events are the lead's; nobody else may post one.
        allow create: if request.resource.data.by == email()
          && (lead() || !(request.resource.data.get('kind', '') in ['approve', 'sendback']))
          && (lead() || designer()
          || (manager() && request.resource.data.kind == 'request' && task().get('sharedEffective', false) == true));
        allow update: if signedIn() && resource.data.by == email()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
        allow delete: if lead();
      }
    }

    // The activity feed reads every task's updates in one collection-group
    // query; that needs its own match. Lead and designers only.
    match /{path=**}/updates/{uid} {
      allow read: if lead() || designer();
    }

    // Everything else - including images (Phase 2) - is closed until a rule
    // above names it.
  }
}
